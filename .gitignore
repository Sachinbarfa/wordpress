# ==============================================================================
# Local by Flywheel Environment & Logs
# ==============================================================================
/logs/
/conf/
/app/sql/
*.sql
*.sql.gz
*.sql.zip
/app/.envrc
.envrc
local-xdebuginfo.php

# ==============================================================================
# WordPress Sensitive Credentials & Configuration
# ==============================================================================
# Database credentials and salts (never commit real passwords)
wp-config.php
!wp-config-sample.php

# ==============================================================================
# WordPress Runtime, Uploads, Cache & Temp Files
# ==============================================================================
# Media uploads (user images, videos, PDFs - should not bloat git repository)
**/wp-content/uploads/

# Temporary directories used during WP core/plugin updates
**/wp-content/upgrade/

# Runtime cache generated by caching plugins
**/wp-content/cache/

# Jetpack Web Application Firewall generated dynamic rules/cache
**/wp-content/jetpack-waf/

# Backup archives and database exports
**/wp-content/backups/
**/wp-content/backup-db/
*.bak
*.backup

# ==============================================================================
# Logs & Debugging
# ==============================================================================
*.log
debug.log
**/wp-content/debug.log

# ==============================================================================
# Operating System Generated Files
# ==============================================================================
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~

# ==============================================================================
# IDE & Code Editor Files
# ==============================================================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# ==============================================================================
# Package Managers & Build Artifacts (Theme / Plugin Development)
# ==============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.env
.env.local
.env.production

# ==============================================================================
# Dynamic Sitemaps
# ==============================================================================
sitemap.xml
sitemap.xml.gz

# ==============================================================================
# (Optional) WordPress Core Files
# Agar aap WordPress core files ko Git me track nahi karna chahte
# (sirf custom code / theme / plugins track karna chahte hain),
# to neeche di gayi lines ko uncomment kar sakte hain:
